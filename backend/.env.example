DATABASE_URL="file:./dev.db"
PORT=4000
# Public URL of the web app (links in emails, CORS).
FRONTEND_ORIGIN=http://localhost:3000
# Other origins allowed to use the API (mirror domains), comma separated.
CORS_EXTRA_ORIGINS=
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
ALLOWED_EMAIL_DOMAIN=

# Chat addresses are username@MAIL_DOMAIN. Production: your domain, with its MX record pointing here.
MAIL_DOMAIN=mailchat.localhost
# Inbound SMTP. Production: 25.
SMTP_INBOUND_PORT=2525
MAILBOX_TTL_DAYS=14

# Optional: sign outgoing mail (production).
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=

# Web Push. Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
